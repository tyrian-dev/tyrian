# Ponder Indexer Environment Variables
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tyrian
DATABASE_SCHEMA=ponder
PORT=42069
INDEXER_NETWORK=testnet
INDEXER_RPC_URL=
INDEXER_RPC_FALLBACK_URLS=
# Drop + rebuild the Ponder schema automatically when indexer inputs change
# (build-id mismatch). Enable on testnet only; leave empty on mainnet.
PONDER_AUTO_RESET=
