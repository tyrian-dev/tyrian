{
  "name": "tyrian",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "contracts",
    "indexer"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:indexer": "bun run --cwd indexer dev",
    "build": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "typecheck": "bun run --cwd frontend typecheck && bun run --cwd backend typecheck && bunx tsc -p indexer --noEmit",
    "lint": "bun run --cwd frontend lint",
    "db:backup": "bun scripts/backup-db.ts",
    "db:restore:verify": "bun scripts/restore-db.ts --verify",
    "db:restore:dry-run": "bun scripts/restore-db.ts --dry-run",
    "reconcile": "bun scripts/reconcile.ts",
    "verify:manifest": "bun scripts/verify-manifest.ts",
    "verify:manifest:testnet": "bun scripts/verify-manifest.ts testnet",
    "verify:manifest:mainnet": "bun scripts/verify-manifest.ts mainnet",
    "test:manifest": "bun test shared/contracts/addresses.test.ts backend/test/network.test.ts",
    "test:backend": "bun test backend/test",
    "check:coverage": "bun scripts/check-coverage.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts --threads 1",
    "contracts:test:mainnet-rehearsal": "forge test --root contracts --match-contract MainnetRehearsalTest -vv",
    "contracts:test:fork": "forge test --root contracts --match-path 'test/fork/*' -vvv",
    "contracts:test:watch": "forge test --root contracts --watch",
    "contracts:format": "forge fmt --root contracts",
    "contracts:deploy:testnet": "bun scripts/deploy-testnet.ts",
    "contracts:deploy:timelock:mainnet": "bun scripts/deploy-timelock.ts",
    "contracts:deploy:core:mainnet": "bun scripts/deploy-core-mainnet.ts",
    "contracts:configure:core:mainnet": "bun scripts/configure-core-mainnet.ts",
    "contracts:handover:core:mainnet": "bun scripts/handover-core-mainnet.ts",
    "contracts:preflight:mainnet": "bun scripts/preflight-mainnet.ts",
    "contracts:deploy:mainnet:guarded": "bun scripts/deploy-mainnet-guarded.ts",
    "manifest:promote": "bun scripts/promote-manifest.ts",
    "contracts:manifest:testnet": "bun scripts/verify-manifest.ts testnet",
    "contracts:manifest:mainnet": "bun scripts/verify-manifest.ts mainnet",
    "contracts:coverage": "forge coverage --root contracts --report summary --exclude-tests --ir-minimum",
    "contracts:slither": "bash scripts/slither.sh",
    "contracts:aderyn": "bash scripts/aderyn.sh",
    "sync": "node scripts/sync-foundry.mjs"
  }
}
