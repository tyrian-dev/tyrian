DATABASE_URL=postgres://<username>:<password>@localhost:5432/<your-database-name>
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Network profile. Chain ID, RPC, explorer, contracts, and the SIWE chain
# allowlist are read from config/networks/<TYRIAN_NETWORK>.json.
TYRIAN_NETWORK=testnet
RPC_FALLBACK_URLS=

# Ponder Indexer URL for live on-chain stake and event ingestion queries
INDEXER_URL=http://localhost:42069

# SIWE session hardening. Bind a signature to the public frontend host. The
# accepted chain ID is the manifest chain ID, so there is no SIWE_CHAIN_IDS.
SIWE_DOMAIN=localhost:3000
