# Backend internal URL used by the Next.js rewrites in next.config.mjs.
BACKEND_INTERNAL_URL=http://localhost:3001

# Client-visible target chain. 46630 = Robinhood Chain Testnet, 4663 = mainnet.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
NEXT_PUBLIC_WC_PROJECT_ID=tyrian_walletconnect_id_placeholder

# preview | live. Live adapters are not implemented yet and must not fall back
# to preview data silently.
NEXT_PUBLIC_DATA_SOURCE=preview
# Off until ToS acceptance persistence and geo enforcement exist on the backend.
NEXT_PUBLIC_ONBOARDING_TOS=false

# Never put private keys or server secrets in NEXT_PUBLIC_* variables.
