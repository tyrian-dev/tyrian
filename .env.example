# ==============================================================================
# Tyrian ($TYRN) Environment Variables
# ==============================================================================
# Contract addresses live in config/networks/*.json, not in this file.
# Switch network with NEXT_PUBLIC_NETWORK=testnet|mainnet.
# Mainnet addresses must be filled in the manifest after verification.

# --- Network selection ---
NEXT_PUBLIC_NETWORK=testnet
TYRIAN_NETWORK=testnet
APP_ENV=local
INDEXER_NETWORK=testnet
EXPECTED_CHAIN_ID=46630
RPC_ALIAS=robinhood_testnet

# --- RPC endpoints (optional overrides; manifest defaults are used otherwise) ---
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.chain.robinhood.com
# Backend reads. Mainnet must use a private/paid endpoint (boot check enforces it).
RPC_URL=
RPC_FALLBACK_URLS=
INDEXER_URL=http://localhost:42069
INDEXER_RPC_URL=
INDEXER_RPC_FALLBACK_URLS=
# Indexer schema guard (RUN-006 §7). Ponder rejects a schema built by different
# config/handlers; PONDER_AUTO_RESET=1 rebuilds it automatically (testnet only).
DATABASE_SCHEMA=ponder
PONDER_AUTO_RESET=
NEXT_PUBLIC_WC_PROJECT_ID=tyrian_walletconnect_id_placeholder

# --- Mainnet deploy runner ---
# The guarded runner is dry-run by default. Broadcasting needs all three:
#   MAINNET_DEPLOY_CONFIRM=yes, DEPLOYER_PRIVATE_KEY, and a non-public RPC.
MAINNET_RPC_URL=
MAINNET_DEPLOY_CONFIRM=
TIMELOCK_PRIVATE_KEY=
VERIFIER_URL=
# Accepted value: schedule | execute
TIMELOCK_ACTION=schedule
# Token-unit caps per ticker, e.g. STOCK_CAP_TSLA=1000000000000000000000
STOCK_CAP_TSLA=
STOCK_CAP_AAPL=
STOCK_CAP_NVDA=
STOCK_CAP_MSFT=
STOCK_CAP_GOOGL=
STOCK_CAP_AMZN=
STOCK_CAP_META=
STOCK_CAP_AMD=

# --- Deploy scripts (do not commit real private keys) ---
DEPLOYER_PRIVATE_KEY=
TREASURY_SAFE=
TREASURY_BUDGET=
TREASURY_RESERVE=
TREASURY_ROUTER=
PORTFOLIO_VAULT=
DEX_ROUTER=
DEX_POOL_FEE=3000
TREASURY_TOTAL_USD=0
DCA_AMOUNT_USD=0
DCA_INTERVAL=604800
MAX_SLIPPAGE_BPS=100
GUARDIAN=
TIMELOCK=
PROTOCOL_OWNER=
USDG_ADDRESS=
TYRN_ADDRESS=
TYR_ADDRESS=
WETH_ADDRESS=
USDG_DEPOSIT_CAP=0
STAKE_MANAGER=
USDG_VAULT=
FEE_SPLITTER=
BUYBACK_BURNER=
BUYBACK_ROUTER=
BUYBACK_POOL_FEE=3000
UNISWAP_POOL=
QUOTE_FEED=
# TYRN TWAP oracle (BUD-003). Pool comes from external.uniswapPool in the
# manifest; these override the quote side when the pool is not TYRN/USDG.
TYRN_TWAP_QUOTE_TOKEN=
TYRN_TWAP_QUOTE_FEED=
TYR_TWAP_QUOTE_TOKEN=
TYR_TWAP_QUOTE_FEED=
KEEPER=
STOCK_TOKEN=
STOCK_SYMBOL=
STOCK_TICKER=
STOCK_FEED=
STOCK_CAP=
STOCK_VAULT=
STOCK_VAULT_COUNT=0
STOCK_VAULT_1=
STOCK_TOKEN_1=
STOCK_FEED_1=

# --- Backend & Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tyrian
REDIS_URL=redis://localhost:6379
SESSION_SECRET=tyrian_session_secret_at_least_32_bytes_long_random_string_here
# AES-256-GCM key for stored OpenRouter sub-keys. Required on mainnet.
OR_KEY_ENC_KEY=
# Protects POST /api/epoch/run. Required on mainnet.
ADMIN_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3001
ALERT_WEBHOOK_URL=
# Private key for automated on-chain daily keeper routing (TreasuryRouter.route())
TREASURY_KEEPER_KEY=
# 60s cache for oracle prices used in quota/epoch math.
PRICING_CACHE_TTL_MS=60000
# Budget window for the daily epoch in days (BUD-001). 1 = yesterday's yield
# funds today's quota. Clamped to 1..7 so a zero window cannot zero the budget.
EPOCH_BUDGET_WINDOW_DAYS=1
# Optional testnet-only fallback price for WETH (production reads Chainlink AggregatorV3 feed)
WETH_USD_PRICE=2500

# --- AI Gateway & OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-mock-key-for-local-testing
OPENROUTER_MGMT_KEY=mock-mgmt-key
# Explicit opt-in. Mock is disabled automatically in production and refused on mainnet.
MOCK_INFERENCE=true

# --- Compliance & Policy ---
BLOCKED_COUNTRIES=US,GB,CA,CH,AE
# true: missing/unknown country header is denied (always on in production/mainnet).
GEO_GATE_STRICT=false
# false is an explicit operator override; refused on mainnet.
ENABLE_GEO_GATE=true
# Comma-separated or JSON array of allowed models / wildcard prefixes (GAP-010)
MODEL_ALLOWLIST=openai/*,anthropic/*,google/*,meta-llama/*,qwen/*,deepseek/*
UTILIZATION_FACTOR=0.9
STOCK_POOL_SHARE=0.4

# --- Feature Flags ---
# NOTE: Protocol feature flags live strictly in config/networks/*.json (e.g. features.stockTokens,
# features.morpho, features.ponsDirectClaim) adhering to AGENTS.md §2. Do NOT add FEATURE_* in .env.

# --- Frontend data / onboarding ---
# preview | live. Live mode must never fall back to preview data.
NEXT_PUBLIC_DATA_SOURCE=preview
# ToS shell is off until acceptance persistence and geo enforcement exist.
NEXT_PUBLIC_ONBOARDING_TOS=false
